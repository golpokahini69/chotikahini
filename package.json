{
  "name": "chotikahini",
  "version": "1.0.0",
  "private": true,
  "description": "A config-driven Bengali literature website built with Next.js",
  "scripts": {
    "dev": "bash scripts/check-disk-space.sh --quiet && next dev --webpack",
    "build": "bash scripts/check-disk-space.sh && next build --webpack",
    "build:local": "bash scripts/check-disk-space.sh && NEXT_DIST_DIR=.next-build next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:disk": "bash scripts/check-disk-space.sh",
    "check:sql:pictures": "bash scripts/verify-tag-sql.sh",
    "check:sql:duplicates": "bash scripts/verify-duplicate-guard.sh",
    "og:preview": "tsx scripts/preview-og.ts",
    "og:preview:grid": "tsx scripts/preview-og.ts --grid",
    "db:export": "node scripts/export-supabase-data.mjs",
    "db:seed": "node scripts/seed-sql.mjs",
    "db:import": "node scripts/import-supabase-data.mjs",
    "db:test": "node tools/db-toolkit/test/literals.test.mjs && node tools/db-toolkit/test/roundtrip.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.11",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.9",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.1",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reading-time": "^1.5.0",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vfile": "^6.0.0"
  }
}
