# =============================================================================
# chotikahini — Environment variables
# Copy to .env.local for local dev. On Vercel, set these in the project env.
# Never commit real secrets.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New-style publishable key (sb_publishable_...). Preferred by the SSR helpers
# in utils/supabase/*, which fall back to the anon key when it is unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site / SEO -------------------------------------------------------------
# Canonical site URL used by the OpenGraph image generators.
NEXT_PUBLIC_SITE_URL=https://chotikahini.vercel.app

# --- Optional analytics -----------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=

# --- Share card tuning ------------------------------------------------------
# How the cover photo is blurred onto the social share card.
#
# OG_COVER_BLUR is the blur sigma as a fraction of the 1200px card width:
#   0.0125 → sigma 15   the cover is almost fully legible
#   0.025  → sigma 30   recognisable, fine detail gone
#   0.05   → sigma 60   colour wash, the shape is gone
#   0.10   → sigma 120  a flat wash with no figure at all
#
# The defaults live in lib/og-cover-background.ts — these env vars only
# override them at runtime, which is handy for tuning on a running
# server without a rebuild. Values are clamped to the legal band.
#
# A light blur puts the cover back in front of the social platforms'
# adult-content classifiers, which is what suppresses the card. If
# shared links start showing a title with no picture, raise this.
# OG_COVER_BLUR=0.0125
#
# OG_COVER_SCRIM is the opacity of the black layer over the blurred
# cover. It is what keeps the white title readable — lower it as the
# blur is lowered, or the card goes dark and the colour drains out.
# OG_COVER_SCRIM=0.22

# --- Cron -------------------------------------------------------------------
# Shared secret used by Vercel Cron when calling /api/cron/* routes.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
# Leave empty locally — the route then falls back to requiring an admin
# session instead.
CRON_SECRET=
